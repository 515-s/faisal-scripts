--// ─── Native Roblox Notification ─────────────────────────────────────────────
local function isGameSupported()
    for _, id in ipairs(SUPPORTED_PLACE_IDS) do
        if game.PlaceId == id then return true end
    end
    return false
end

local function sendRobloxNotification()
    if not isGameSupported() then return end

    local StarterGui = game:GetService("StarterGui")

    local tries = 0
    local success = false
    while tries < 20 and not success do
        local ok = pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Script Supported",
                Text = "This script supports this game | هذا السكربت يدعم هذه اللعبة",
                Duration = 5,
            })
        end)
        if ok then
            success = true
        else
            tries = tries + 1
            task.wait(0.5)
        end
    end
end

task.spawn(sendRobloxNotification)
