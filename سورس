--// ─── Role detection (للعبة الأولى) ──────────────────────────────────────────
local function getRole(player)
    local role = player:FindFirstChild("Role")
    if role and role:IsA("StringValue") then
        return role.Value
    end
    return "None"
end

--// ─── تحديد اللون حسب اللعبة ─────────────────────────────────────────────────
local function getPlayerColor(player)
    if game.PlaceId == CFG.SECOND_GAME_PLACE_ID then
        -- اللعبة التانية: كل اللاعبين أخضر
        return CFG.PlayerColor
    end
    -- اللعبة الأولى: حسب الدور
    local role = getRole(player)
    return CFG.RoleColors[role] or CFG.RoleColors.None
end

