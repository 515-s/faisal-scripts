local function hideAll(d)
    d.Box.Visible      = false
    d.Name.Visible     = false
    d.Distance.Visible = false
    d.Tracer.Visible   = false
    if d.FarterLabel then d.FarterLabel.Visible = false end
end

local function applyBoxColor(d, color)
    if d.LastColor == color then return end
    d.LastColor = color
    if d.BoxParts then
        for _, part in pairs(d.BoxParts) do
            part.BackgroundColor3 = color
        end
    end
    if d.Tracer then
        d.Tracer.BackgroundColor3 = color
    end
end

--// ─── Visibility helper (raycast) ────────────────────────────────────────────
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isVisible(char, target)
    if not CFG.VisibleOnly then return true end
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    rayParams.FilterDescendantsInstances = { myChar, char }
    local origin = Camera.CFrame.Position
    local dir = target.Position - origin
    local res = Workspace:Raycast(origin, dir, rayParams)
    return res == nil
end

local function sameTeam(a, b)
    if not CFG.TeamCheck then return false end
    return a.Team ~= nil and a.Team == b.Team
end

--// ─── Per-frame update ───────────────────────────────────────────────────────
local function worldToViewport(p)
    if not Camera then return Vector2.new(0, 0), false end
    local pt, vis = Camera:WorldToViewportPoint(p)
    return Vector2.new(pt.X, pt.Y), vis and pt.Z > 0
end

local function drawESPForModel(model, d, label, color, maxDist)
    if not model or not model.Parent then return hideAll(d) end

    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Head")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")

    if not root then return hideAll(d) end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return hideAll(d) end

    local dv = (myRoot.Position - root.Position).Magnitude
    if dv > maxDist then return hideAll(d) end

    applyBoxColor(d, color)

    local cf, size = model:GetBoundingBox()
    local topW = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
    local botW = cf.Position - Vector3.new(0, size.Y * 0.5, 0)

    local top, tv = worldToViewport(topW)
    local bot, bv = worldToViewport(botW)
    if not tv or not bv then return hideAll(d) end

    local h = math.abs(bot.Y - top.Y)
    if h < 2 then return hideAll(d) end

    h = h * CFG.BoxScale

    local w = h * 0.5
    local left = top.X - w * 0.5

    if CFG.ShowBox then
        d.Box.Position = UDim2.fromOffset(left, top.Y)
        d.Box.Size     = UDim2.fromOffset(w, h)
        d.Box.Visible  = true
    else
        d.Box.Visible = false
    end

    if label and label ~= "" then
        d.Name.Text     = label
        d.Name.Position = UDim2.fromOffset(top.X, top.Y - 4)
        d.Name.Visible  = true
    else
        d.Name.Visible = false
    end

    if CFG.ShowDist then
        d.Distance.Text     = string.format("[%d studs]", math.floor(dv))
        d.Distance.Position = UDim2.fromOffset(top.X, bot.Y + 3)
        d.Distance.Visible  = true
    else
        d.Distance.Visible = false
    end

    if CFG.ShowTracer then
        local vp = Camera.ViewportSize
        local ox, oy = vp.X * 0.5, vp.Y
        local tx, ty = top.X + w * 0.5, bot.Y
        local dx, dy = tx - ox, ty - oy
        local len = math.sqrt(dx * dx + dy * dy)
        if len > 1 then
            d.Tracer.Position = UDim2.fromOffset(ox, oy)
            d.Tracer.Size     = UDim2.fromOffset(1, len)
            d.Tracer.Rotation = math.deg(math.atan2(dy, dx)) - 90
            d.Tracer.Visible  = true
        end
    else
        d.Tracer.Visible = false
    end
end

local function updatePlayer(player, d)
    local char = player.Character
    if not char then return hideAll(d) end

    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return hideAll(d) end

    if sameTeam(player, LocalPlayer) then return hideAll(d) end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return hideAll(d) end

    local dv = (myRoot.Position - root.Position).Magnitude
    if dv > CFG.MaxDistance then return hideAll(d) end

    if CFG.VisibleOnly and not isVisible(char, root) then return hideAll(d) end

    --// اللون حسب اللعبة ───────────────────────────────────────────────────
    local playerColor = getPlayerColor(player)
    applyBoxColor(d, playerColor)
    --// ───────────────────────────────────────────────────────────────────────

    local cf, size = char:GetBoundingBox()
    local topW = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
    local botW = cf.Position - Vector3.new(0, size.Y * 0.5, 0)

    local top, tv = worldToViewport(topW)
    local bot, bv = worldToViewport(botW)
    if not tv or not bv then return hideAll(d) end

    local h = math.abs(bot.Y - top.Y)
    if h < 2 then return hideAll(d) end

    h = h * CFG.BoxScale

    local w = h * 0.5
    local left = top.X - w * 0.5

    if CFG.ShowBox then
        d.Box.Position = UDim2.fromOffset(left, top.Y)
        d.Box.Size     = UDim2.fromOffset(w, h)
        d.Box.Visible  = true
    else
        d.Box.Visible = false
    end

    if CFG.ShowName then
        d.Name.Text     = player.Name
        d.Name.Position = UDim2.fromOffset(top.X, top.Y - 4)
        d.Name.Visible  = true
    else
        d.Name.Visible = false
    end

    if CFG.ShowDist then
        d.Distance.Text     = string.format("[%d studs]", math.floor(dv))
        d.Distance.Position = UDim2.fromOffset(top.X, bot.Y + 3)
        d.Distance.Visible  = true
    else
        d.Distance.Visible = false
    end

    --// FARTER label: بس في اللعبة الأولى ولما الدور فارتر ──────────────────
    if CFG.ShowFarterLabel
        and game.PlaceId ~= CFG.SECOND_GAME_PLACE_ID
        and getRole(player) == "Farter" then
        d.FarterLabel.Text     = "FARTER"
        d.FarterLabel.TextColor3 = playerColor
        d.FarterLabel.Position = UDim2.fromOffset(top.X, top.Y - 22)
        d.FarterLabel.Visible  = true
    else
        d.FarterLabel.Visible  = false
    end
    --// ───────────────────────────────────────────────────────────────────────

    if CFG.ShowTracer then
        local vp = Camera.ViewportSize
        local ox, oy = vp.X * 0.5, vp.Y
        local tx, ty = top.X + w * 0.5, bot.Y
        local dx, dy = tx - ox, ty - oy
        local len = math.sqrt(dx * dx + dy * dy)
        if len > 1 then
            d.Tracer.Position = UDim2.fromOffset(ox, oy)
            d.Tracer.Size     = UDim2.fromOffset(1, len)
            d.Tracer.Rotation = math.deg(math.atan2(dy, dx)) - 90
            d.Tracer.Visible  = true
        end
    else
        d.Tracer.Visible = false
    end
end

