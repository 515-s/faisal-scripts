--// ─── Randomizer ─────────────────────────────────────────────────────────────
local RNG = Random.new(os.clock() * 1e6)
local function rid(n)
    local A = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz"
    local out = {}
    for i = 1, n do
        local p = RNG:NextInteger(1, #A)
        out[i] = A:sub(p, p)
    end
    return table.concat(out)
end
