--// ─── Registry ───────────────────────────────────────────────────────────────
local function removePlayer(p)
    local d = ESP[p]
    if d and d.Gui then pcall(function() d.Gui:Destroy() end) end
    ESP[p] = nil
end

local function removeDeer(m)
    local d = DeerESP[m]
    if d and d.Gui then pcall(function() d.Gui:Destroy() end) end
    DeerESP[m] = nil
end

