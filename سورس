--// ─── Executor capability probe ─────────────────────────────────────────────
local EXEC = {}
do
    local env = (type(getgenv) == "function") and getgenv() or _G
    local function has(n) return type(rawget(env, n)) == "function" end
    EXEC.gethui            = has("gethui")
    EXEC.protect_gui       = has("protect_gui")
    EXEC.newcclosure       = has("newcclosure")
    EXEC.hookmetamethod    = has("hookmetamethod")
    EXEC.setreadonly       = has("setreadonly")
    EXEC.getrawmetatable   = has("getrawmetatable")
    EXEC.cloneref          = has("cloneref")
    EXEC.checkcaller       = has("checkcaller")
    EXEC.getnamecallmethod = has("getnamecallmethod")
end

local newcclosure = (EXEC.newcclosure and rawget(_G, "newcclosure"))
    or function(f) return f end

local cloneref = (EXEC.cloneref and rawget(_G, "cloneref"))
    or function(x) return x end

local checkcaller = (EXEC.checkcaller and rawget(_G, "checkcaller"))
    or function() return false end

local hookmetamethod    = EXEC.hookmetamethod    and rawget(_G, "hookmetamethod")
local getnamecallmethod = EXEC.getnamecallmethod and rawget(_G, "getnamecallmethod")
local getrawmetatable   = EXEC.getrawmetatable   and rawget(_G, "getrawmetatable")

