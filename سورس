--// ─── Anti-detection: namecall hook ──────────────────────────────────────────
do
    if hookmetamethod and getrawmetatable and getnamecallmethod then
        local mt = getrawmetatable(game)
        if mt then
            local old
            old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if not checkcaller() then
                    local m = getnamecallmethod()
                    if self == LogService and (m == "Log" or m == "MessageOut") then
                        return nil
                    end
                    if self == Players and m == "Kick" then
                        return nil
                    end
                end
                return old(self, ...)
            end))
        end
    end
end

--// ─── Anti-detection: GUI parent selection ───────────────────────────────────
local function preferredParents()
    local out = {}
    if EXEC.gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then table.insert(out, hui) end
    end
    local okCG, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if okCG and coreGui then table.insert(out, coreGui) end
    local okPG, playerGui = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
    if okPG and playerGui then table.insert(out, playerGui) end
    return out
end

local function protectGui(gui)
    if not gui then return end
    if EXEC.protect_gui then pcall(protect_gui, gui) end
    if syn and syn.protect_gui then pcall(syn.protect_gui, gui) end
end

local function newHiddenGui()
    local gui = Instance.new("ScreenGui")
    gui.Name            = "_" .. rid(10)
    gui.IgnoreGuiInset  = true
    gui.ResetOnSpawn    = false
    gui.DisplayOrder    = 999
    gui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling

    protectGui(gui)

    for _, parent in ipairs(preferredParents()) do
        local ok = pcall(function() gui.Parent = parent end)
        if ok and gui.Parent then break end
    end

    return gui
end

--// ─── 4-frame box builder ────────────────────────────────────────────────────
local function buildBox(parent, color, thickness)
    local box = Instance.new("Frame")
    box.Name                   = "_" .. rid(6)
    box.BackgroundTransparency = 1
    box.BorderSizePixel        = 0
    box.Visible                = false
    box.Parent                 = parent

    local top = Instance.new("Frame")
    top.Name             = "_" .. rid(5)
    top.BackgroundColor3 = color
    top.BorderSizePixel  = 0
    top.Size             = UDim2.new(1, 0, 0, thickness)
    top.Position         = UDim2.new(0, 0, 0, 0)
    top.Parent           = box

    local bottom = Instance.new("Frame")
    bottom.Name             = "_" .. rid(5)
    bottom.BackgroundColor3 = color
    bottom.BorderSizePixel  = 0
    bottom.Size             = UDim2.new(1, 0, 0, thickness)
    bottom.Position         = UDim2.new(0, 0, 1, -thickness)
    bottom.Parent           = box

    local left = Instance.new("Frame")
    left.Name             = "_" .. rid(5)
    left.BackgroundColor3 = color
    left.BorderSizePixel  = 0
    left.Size             = UDim2.new(0, thickness, 1, 0)
    left.Position         = UDim2.new(0, 0, 0, 0)
    left.Parent           = box

    local right = Instance.new("Frame")
    right.Name             = "_" .. rid(5)
    right.BackgroundColor3 = color
    right.BorderSizePixel  = 0
    right.Size             = UDim2.new(0, thickness, 1, 0)
    right.Position         = UDim2.new(1, -thickness, 0, 0)
    right.Parent           = box

    return box, { top = top, bottom = bottom, left = left, right = right }
end

