--// ─── Main loop ──────────────────────────────────────────────────────────────
Camera = Workspace.CurrentCamera

local conn
conn = RunService.RenderStepped:Connect(newcclosure(function(dt)
    if Workspace.CurrentCamera ~= Camera then
        Camera = Workspace.CurrentCamera
    end

    local stale = nil
    for p, d in pairs(ESP) do
        if p.Parent == nil then
            stale = stale or {}
            table.insert(stale, p)
        else
            pcall(updatePlayer, p, d)
        end
    end
    if stale then
        for _, p in ipairs(stale) do
            removePlayer(p)
        end
    end

    for model, d in pairs(DeerESP) do
        if not model.Parent then
            removeDeer(model)
        else
            pcall(drawESPForModel, model, d, CFG.DeerLabel, CFG.DeerColor, CFG.DeerMaxDistance)
        end
    end

    if FOVCircle then
        FOVCircle.Visible = CFG.ShowFOV
        if CFG.ShowFOV and Camera then
            local vp = Camera.ViewportSize
            local dd = CFG.FOVRadius * 2
            FOVCircle.Position = UDim2.fromOffset(vp.X * 0.5, vp.Y * 0.5)
            FOVCircle.Size     = UDim2.fromOffset(dd, dd)
        end
    end
end))

