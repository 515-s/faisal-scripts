local function makeToggleBtn(parent, size, order, labelText, getter, setter, opts)
    opts = opts or {}
    local borderColor = opts.borderColor or THEME.GREEN
    local dotColor = opts.dotColor or THEME.GREEN
    local textColorOn = opts.textColor or THEME.GREEN
    local bgOn = opts.bgOn or Color3.fromRGB(15, 35, 20)
    local bgOff = opts.bgOff or Color3.fromRGB(25, 25, 25)
    local borderTransOn = opts.borderTransOn or 0.7
    local borderTransOff = opts.borderTransOff or 0.9

    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.BackgroundColor3 = getter() and bgOn or bgOff
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = borderColor
    s.Thickness = 1
    s.Transparency = getter() and borderTransOn or borderTransOff
    s.Parent = btn

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 8, 0, 8)
    dot.Position = UDim2.new(0, 12, 0.5, -4)
    dot.BackgroundColor3 = getter() and dotColor or Color3.fromRGB(70, 70, 70)
    dot.BorderSizePixel = 0
    dot.Parent = btn

    local dc = Instance.new("UICorner")
    dc.CornerRadius = UDim.new(1, 0)
    dc.Parent = dot

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -28, 1, 0)
    lbl.Position = UDim2.new(0, 26, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextColor3 = getter() and textColorOn or THEME.TEXT_OFF
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = labelText
    lbl.Parent = btn

    btn.Activated:Connect(function()
        setter(not getter())
