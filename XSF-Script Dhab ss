-- ===== Helpers =====
local function getWild()
    local w = workspace:FindFirstChild("DhabWild")
    if w then return w end
    w = workspace:FindFirstChild("Wildlife")
    if w then return w end
    for _, o in ipairs(workspace:GetChildren()) do
        local d = o:FindFirstChild("DhabWild")
        if d then return d end
    end
    return nil
end

local function tierOf(c)
    local t = c:GetAttribute("Tier")
    if type(t) == "string" then t = string.match(t, "%d+") end
    return tonumber(t) or 1
end

local function getHitbox(c)
    return c:FindFirstChild("Hitbox") or c:FindFirstChild("hitbox") or c:FindFirstChild("HITBOX")
end

-- ===== Head Bone =====
local function getHeadBone(c)
    local found = c:FindFirstChild("Head", true)
    if not found then return nil end
    if found:IsA("Bone") then
        local ok, pos = pcall(function() return found.WorldPosition end)
        if ok and pos and pos.Magnitude > 0 then return pos end
        local ok2, cf = pcall(function() return found.WorldCFrame end)
        if ok2 and cf then return cf.Position end
    elseif found:IsA("BasePart") then
        return found.Position
    end
    return nil
end

-- ===== Aim Point =====
local function getAimPoint(c)
    if CFG.AIM_MODE == "head_bone" then
        local hp = getHeadBone(c)
        if hp then return hp, "head_bone" end
    end

    local hitbox = getHitbox(c)
    if not hitbox or not hitbox:IsA("BasePart") then
        return c.PrimaryPart and c.PrimaryPart.Position or nil, "primarypart"
    end

    if CFG.AIM_MODE == "hitbox" then
        return hitbox.Position, "hitbox"
    elseif CFG.AIM_MODE == "hitbox_high" then
        return hitbox.Position + Vector3.new(0, hitbox.Size.Y * CFG.HEADSHOT_HEIGHT, 0), "hitbox_high"
    elseif CFG.AIM_MODE == "hitbox_head" or CFG.AIM_MODE == "head_bone" then
        local up  = Vector3.new(0, hitbox.Size.Y * CFG.HEADSHOT_HEIGHT, 0)
        local fwd = -hitbox.CFrame.LookVector * (hitbox.Size.Z * CFG.HEADSHOT_FORWARD)
        return hitbox.Position + up + fwd, "hitbox_head"
    else
        return c.PrimaryPart and c.PrimaryPart.Position or nil, "primarypart"
    end
end

-- ===== Predictive Aim =====
local function predictAimPos(aimPos, c, headPos)
    if not CFG.PREDICTIVE then return aimPos end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum and hum.MoveDirection and hum.MoveDirection.Magnitude > 0.1 then
        local speed = hum.WalkSpeed or 16
        local dist = (aimPos - headPos).Magnitude
        local t = math.clamp(dist / CFG.PROJECTILE_SPEED, 0, 0.5) * CFG.PREDICT_GAIN
        return aimPos + hum.MoveDirection * speed * t
    end
    local hitbox = getHitbox(c)
    if not hitbox then return aimPos end
    local vel = hitbox.AssemblyLinearVelocity
    if not vel or vel.Magnitude < 0.5 then return aimPos end
    local dist = (aimPos - headPos).Magnitude
    local t = math.clamp(dist / CFG.PROJECTILE_SPEED, 0, 0.5) * CFG.PREDICT_GAIN
    return aimPos + vel * t
end

-- ===== Closest Distance (surface) =====
local function getClosestDistance(headPos, c)
    local hitbox = getHitbox(c)
    if CFG.USE_CLOSEST_SURFACE and hitbox and hitbox:IsA("BasePart") then
        local ok, closest = pcall(function() return hitbox:ClosestPointOnSurface(headPos) end)
        if ok and closest then return (closest - headPos).Magnitude end
    end
    if c.PrimaryPart then return (c.PrimaryPart.Position - headPos).Magnitude end
    return 1e9
end

local function ensureHrpAttach()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    if state.hrpAttach and state.hrpAttach.Parent == hrp then return state.hrpAttach end
    if state.hrpAttach then pcall(function() state.hrpAttach:Destroy() end) end
    state.hrpAttach = Instance.new("Attachment")
    state.hrpAttach.Name = "XK_ESPAttach"
    state.hrpAttach.Parent = hrp
    return state.hrpAttach
end

-- ===== ESP =====
local function createESP(c, tier)
    local color = (tier >= 6) and CFG.ESP_COLOR_T6 or CFG.ESP_COLOR_T5
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.FillTransparency = 0.5
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.Adornee = c
    pcall(function() hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
    hl.Parent = c

    local att = ensureHrpAttach()
    local att2, beam = nil, nil
    if att and c.PrimaryPart then
        att2 = Instance.new("Attachment")
        att2.Parent = c.PrimaryPart
        beam = Instance.new("Beam")
        beam.FaceCamera = true
        beam.Width0 = CFG.ESP_BEAM_WIDTH
        beam.Width1 = CFG.ESP_BEAM_WIDTH
        beam.Color = ColorSequence.new(color)
        beam.LightEmission = 1
        beam.Segments = CFG.ESP_BEAM_SEGS
        beam.Attachment0 = att
        beam.Attachment1 = att2
        pcall(function() beam.DepthMode = Enum.BeamDepthMode.AlwaysOnTop end)
        beam.Parent = c
    end
    return {highlight = hl, beam = beam, att1 = att, att2 = att2, tier = tier}
end

local function destroyESP(c)
    local e = state.espEntries[c]
    if not e then return end
    pcall(function() e.highlight:Destroy() end)
    pcall(function() e.beam:Destroy() end)
    pcall(function() e.att2:Destroy() end)
    state.espEntries[c] = nil
end

local function clearAllESP()
    for c in pairs(state.espEntries) do destroyESP(c) end
    if state.hrpAttach then pcall(function() state.hrpAttach:Destroy() end); state.hrpAttach = nil end
end

local function updateESP()
    local wild = getWild()
    local seen = {}
    if wild then
        for _, c in ipairs(wild:GetChildren()) do
            if c:IsA("Model") and c.PrimaryPart and c:GetAttribute("State") ~= "dead" then
                local tier = tierOf(c)
                local shouldShow = (tier == 5 and state.espT5On) or (tier == 6 and state.espT6On)
                if shouldShow then
                    seen[c] = true
                    if not state.espEntries[c] then
                        state.espEntries[c] = createESP(c, tier)
                    else
                        state.espEntries[c].highlight.Adornee = c
                        state.espEntries[c].highlight.Enabled = true
                        if state.espEntries[c].beam then state.espEntries[c].beam.Enabled = true end
                        if state.espEntries[c].att2 then state.espEntries[c].att2.Parent = c.PrimaryPart end
                    end
                end
            end
        end
    end
    for c in pairs(state.espEntries) do
        if not seen[c] or not c.Parent or c:GetAttribute("State") == "dead" then
            destroyESP(c)
        end
    end
end

-- ===== Purge =====
local function purgeDesertCompletely()
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant.Name == "Desert" then
            for _, subObj in ipairs(descendant:GetDescendants()) do
                pcall(function() subObj:Destroy() end)
            end
            pcall(function() descendant:Destroy() end)
        end
    end
end

-- ===== Reload Guard =====
local function weaponContainers()
    local list = {}
    local char = player.Character
    if char then
        table.insert(list, char)
        local backpack = player:FindFirstChild("Backpack")
        if backpack then table.insert(list, backpack) end
    end
    local pg = player:FindFirstChild("PlayerGui")
    if pg then table.insert(list, pg) end
    return list
end

local function scanForReloadSignal(root)
    if not root then return false end
    local bools = {}
    local nums = {}
    for _, obj in ipairs(root:GetDescendants()) do
        local nm = obj.Name
        local isHint = false
        for _, hint in ipairs(CFG.RELOAD_HINTS) do
            if string.find(nm, hint, 1, true) then isHint = true; break end
        end
        if isHint then
            if obj:IsA("BoolValue") then
                bools[nm] = obj.Value
            elseif obj:IsA("NumberValue") or obj:IsA("IntValue") then
                nums[nm] = obj.Value
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local txt = string.lower(obj.Text or "")
                if string.find(txt, "reload", 1, true) and obj.Visible then
                    return true
                end
            end
        end
    end
    for name, val in pairs(bools) do
        if val == true and (string.find(name, "Reload", 1, true) or string.find(name, "IsReloading", 1, true)) then
            return true
        end
    end
    for name, val in pairs(nums) do
        if string.find(name, "Ammo", 1, true) or string.find(name, "Mag", 1, true) then
            if not nums[name .. "Max"] and val <= 0 then
                return true
            end
        end
    end
    return false
end

local function isReloading()
    if not CFG.RELOAD_GUARD then return false end
    if tick() < state.reloadUntil then return true end
    for _, root in ipairs(weaponContainers()) do
        local ok, res = pcall(scanForReloadSignal, root)
        if ok and res then
            state.reloadUntil = tick() + CFG.RELOAD_TIMEOUT
            return true
        end
    end
    return false
end

-- ===== Find Closest =====
local function findClosest(headPos)
    local wild = getWild()
    if not wild then return nil, nil end
    local best, bestDist = nil, 1e9
    for _, c in ipairs(wild:GetChildren()) do
        if c:IsA("Model") and c.PrimaryPart and c:GetAttribute("State") ~= "dead" then
            local d = getClosestDistance(headPos, c)
            if d >= CFG.MIN_RANGE and d <= CFG.MAX_RANGE and d < bestDist then
                best = c
                bestDist = d
            end
        end
    end
    return best, bestDist
end

local function hasLOS(headPos, target, char)
    if not CFG.REQUIRE_LOS then return true end
    local hitbox = getHitbox(target)
    local tPos = (hitbox and hitbox.Position) or (target.PrimaryPart and target.PrimaryPart.Position)
    if not tPos then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, target}
    params.IgnoreWater = true
    local ok, res = pcall(function()
        return workspace:Raycast(headPos, tPos - headPos, params)
    end)
    if not ok then return false end
    return res == nil
end

local function checkKills()
    for c, _ in pairs(state.tracked) do
        if not c.Parent then
            state.kills += 1
            state.tracked[c] = nil
            destroyESP(c)
        elseif c:GetAttribute("State") == "dead" then
            state.kills += 1
            state.tracked[c] = nil
            destroyESP(c)
        end
    end
end

-- ===== Loops =====
local purgeThread = task.spawn(function()
    while state.running do
        if state.purgeOn then pcall(purgeDesertCompletely) end
        task.wait(CFG.PURGE_INTERVAL)
    end
end)

local espThread = task.spawn(function()
    while state.running do
        pcall(updateESP)
        task.wait(0.5)
    end
end)

local fireThread = task.spawn(function()
    while state.running do
        if not state.fireOn then task.wait(0.1); continue end
        local now = tick()
        if now - state.lastFire < CFG.FIRE_INTERVAL then task.wait(0.02); continue end
        if isReloading() then task.wait(CFG.RELOAD_POLL); continue end

        checkKills()
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        if not head then task.wait(0.2); continue end

        local target, dist = findClosest(head.Position)
        if not (target and target.PrimaryPart) then task.wait(0.1); continue end
        if not hasLOS(head.Position, target, char) then task.wait(0.1); continue end

        local origin = head.Position
        local aimPos, mode = getAimPoint(target)
        if not aimPos then task.wait(0.1); continue end

        aimPos = predictAimPos(aimPos, target, origin)

        local dir = (aimPos - origin).Unit
        local ok = pcall(function()
            Event:FireServer("Fire", {
                origin = origin,
                direction = dir,
                draw = CFG.DRAW_VALUE,
            })
        end)
        if ok then
            state.fired += 1
            state.lastFire = now
            state.tracked[target] = true
        end
        task.wait(0.02)
    end
end)

