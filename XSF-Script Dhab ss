-- ===== Kill =====
local function xk_kill()
    state.running = false
    state.fireOn = false
    state.espT5On = false
    state.espT6On = false
    state.purgeOn = false
    clearAllESP()
    pcall(function() if fireThread and fireThread.close then fireThread:close() end end)
    pcall(function() if espThread and espThread.close then espThread:close() end end)
    pcall(function() if purgeThread and purgeThread.close then purgeThread:close() end end)
    pcall(function() gui:Destroy() end)
    if _G.xk_active and _G.xk_active.self then _G.xk_active = nil end
end

_G.xk_kill = xk_kill
_G.xk_stop = function()
    state.fireOn = false
    state.espT5On = false
    state.espT6On = false
    state.purgeOn = false
end
_G.xk_stats = function()
    return string.format("[XSF] fired=%d kills=%d reloadUntil=%.2f", state.fired, state.kills, state.reloadUntil)
end
_G.xk_config = function(t)
    if type(t)=="table" then
        for k,v in pairs(t) do if CFG[k]~=nil then CFG[k]=v end end
    end
end

_G.xk_active = {stop = _G.xk_stop, kill = xk_kill, self = true, startedAt = tick()}

