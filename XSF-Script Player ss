local mainConn = RunService.RenderStepped:Connect(function()
    if Workspace.CurrentCamera ~= Camera then
        Camera = Workspace.CurrentCamera
    end

    if not state.espOn then
        for p, d in pairs(state.espEntries) do
            pcall(hideAll, d)
        end
        return
    end

    local stale = nil
    for p, d in pairs(state.espEntries) do
        if p.Parent == nil then
            stale = stale or {}
            table.insert(stale, p)
        else
            pcall(updatePlayer, p, d)
        end
    end

    if stale then
        for _, p in ipairs(stale) do
            removePlayer(p)
        end
    end
end)

