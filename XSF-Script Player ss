local function getGuiParent()
    if type(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return player:WaitForChild("PlayerGui")
end

local function protectGui(g)
    if type(protectgui) == "function" then pcall(function() protectgui(g) end) end
    if type(syn) == "table" and type(syn.protect_gui) == "function" then pcall(function() syn.protect_gui(g) end) end
end

local function worldToViewport(p)
    if not Camera then return Vector2.new(0, 0), false end
    local pt, vis = Camera:WorldToViewportPoint(p)
    return Vector2.new(pt.X, pt.Y), vis and pt.Z > 0
end

local function isVisible(char, target)
    if not CFG.VISIBLE_ONLY then return true end
    local myChar = player.Character
    if not myChar then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, char }
    params.IgnoreWater = true
    local origin = Camera.CFrame.Position
    local ok, res = pcall(function()
        return Workspace:Raycast(origin, target.Position - origin, params)
    end)
    if not ok then return false end
    return res == nil
end

local function sameTeam(a, b)
    if not CFG.TEAM_CHECK then return false end
    return a.Team ~= nil and a.Team == b.Team
end

