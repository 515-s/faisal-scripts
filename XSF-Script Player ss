local function buildBox(parent, color, thickness)
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = parent

    local t = Instance.new("Frame")
    t.BackgroundColor3 = color
    t.BorderSizePixel = 0
    t.Size = UDim2.new(1, 0, 0, thickness)
    t.Parent = box

    local b = Instance.new("Frame")
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Size = UDim2.new(1, 0, 0, thickness)
    b.Position = UDim2.new(0, 0, 1, -thickness)
    b.Parent = box

    local l = Instance.new("Frame")
    l.BackgroundColor3 = color
    l.BorderSizePixel = 0
    l.Size = UDim2.new(0, thickness, 1, 0)
    l.Parent = box

    local r = Instance.new("Frame")
    r.BackgroundColor3 = color
    r.BorderSizePixel = 0
    r.Size = UDim2.new(0, thickness, 1, 0)
    r.Position = UDim2.new(1, -thickness, 0, 0)
    r.Parent = box

    return box, { top = t, bottom = b, left = l, right = r }
end

