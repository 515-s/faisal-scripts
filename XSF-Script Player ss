-- ===== Anti-detection (silent log + kick) =====
do
    if type(hookmetamethod) == "function" and type(getrawmetatable) == "function" and type(getnamecallmethod) == "function" then
        local ok, mt = pcall(getrawmetatable, game)
        if ok and mt then
            local old
            old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if not checkcaller() then
                    local m = getnamecallmethod()
                    if self == LogService and (m == "Log" or m == "MessageOut") then
                        return nil
                    end
                    if self == Players and m == "Kick" then
                        return nil
                    end
                end
                return old(self, ...)
            end))
        end
    end
end

