local function hideAll(d)
    d.Box.Visible = false
    d.Name.Visible = false
    d.Distance.Visible = false
    d.Tracer.Visible = false
end

local function updatePlayer(p, d)
    if not state.espOn then return hideAll(d) end

    local char = p.Character
    if not char then return hideAll(d) end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return hideAll(d) end

    if sameTeam(p, player) then return hideAll(d) end

    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return hideAll(d) end

    local dv = (myRoot.Position - root.Position).Magnitude
    if dv > CFG.MAX_DISTANCE then return hideAll(d) end
    if CFG.VISIBLE_ONLY and not isVisible(char, root) then return hideAll(d) end

    local cf, size = char:GetBoundingBox()
    local topW = cf.Position + Vector3.new(0, size.Y * 0.5, 0)
    local botW = cf.Position - Vector3.new(0, size.Y * 0.5, 0)

    local top, tv = worldToViewport(topW)
    local bot, bv = worldToViewport(botW)
    if not tv or not bv then return hideAll(d) end

    local h = math.abs(bot.Y - top.Y)
    if h < 2 then return hideAll(d) end

    h = h * CFG.BOX_SCALE
    local w = h * 0.5
    local left = top.X - w * 0.5

    if CFG.SHOW_BOX then
        d.Box.Position = UDim2.fromOffset(left, top.Y)
        d.Box.Size = UDim2.fromOffset(w, h)
        d.Box.Visible = true
    else
        d.Box.Visible = false
    end

    if CFG.SHOW_NAME then
        d.Name.Text = p.Name
        d.Name.Position = UDim2.fromOffset(top.X, top.Y - 4)
        d.Name.Visible = true
    else
        d.Name.Visible = false
    end

    if CFG.SHOW_DIST then
        d.Distance.Text = string.format("[%d studs]", math.floor(dv))
        d.Distance.Position = UDim2.fromOffset(top.X, bot.Y + 3)
        d.Distance.Visible = true
    else
        d.Distance.Visible = false
    end

    if CFG.SHOW_TRACER and Camera then
        local vp = Camera.ViewportSize
        local ox, oy = vp.X * 0.5, vp.Y
        local tx, ty = top.X + w * 0.5, bot.Y
        local dx, dy = tx - ox, ty - oy
        local len = math.sqrt(dx * dx + dy * dy)
        if len > 1 then
            d.Tracer.Position = UDim2.fromOffset(ox, oy)
            d.Tracer.Size = UDim2.fromOffset(1, len)
            d.Tracer.Rotation = math.deg(math.atan2(dy, dx)) - 90
            d.Tracer.Visible = true
        else
            d.Tracer.Visible = false
        end
    else
        d.Tracer.Visible = false
    end
end

local function removePlayer(p)
    local d = state.espEntries[p]
    if d and d.Gui then pcall(function() d.Gui:Destroy() end) end
    state.espEntries[p] = nil
end

